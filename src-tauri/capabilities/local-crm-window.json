{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-crm-window-controls",
  "description": "Allow local or contest-hosted RampPulse windows to use native window controls and events.",
  "windows": ["main", "session-*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "https://*.trycloudflare.com"]
  },
  "permissions": ["core:window:allow-close", "core:event:allow-listen"]
}
