{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RampPulse",
  "version": "0.5.0",
  "identifier": "ru.oto.airport-crm",
  "build": {
    "beforeDevCommand": "npm run ui:build",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "splash.html",
        "title": "RampPulse · Операционный центр",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#0A0E17"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://*.trycloudflare.com wss://*.trycloudflare.com data: blob:; img-src 'self' data: blob: http://127.0.0.1:* https://*.trycloudflare.com; style-src 'self' 'unsafe-inline' https://*.trycloudflare.com; script-src 'self' 'unsafe-inline' http://127.0.0.1:* https://*.trycloudflare.com; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://*.trycloudflare.com wss://*.trycloudflare.com"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "RampPulse · Airport operations desktop application",
    "resources": {
      "../data/": "data/",
      "../web/dist/": "frontend/",
      "resources/server/": "server/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "deb",
      "rpm"
    ]
  }
}
