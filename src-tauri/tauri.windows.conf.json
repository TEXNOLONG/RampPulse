{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RampPulse",
  "version": "0.6.21",
  "identifier": "ru.oto.airport-crm",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "title": "RampPulse",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline'; font-src 'self' https: data:; media-src 'self' https: blob:; worker-src 'self' blob:; connect-src 'self' https: wss: stun: turn: turns:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "resources": {
      "../data/": "data/",
      "resources/server/": "server/",
      "../web/dist/": "frontend/"
    },
    "targets": [
      "nsis"
    ]
  }
}
