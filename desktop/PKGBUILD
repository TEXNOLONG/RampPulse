pkgname=ramppulse
pkgver=0.5.0
pkgrel=1
pkgdesc='RampPulse · Операционный центр для аэропортовых служб'
arch=('x86_64')
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'gst-plugins-good')
provides=('airport-crm')
conflicts=('airport-crm')
replaces=('airport-crm')
options=('!strip')
source=()
sha256sums=()

package() {
  local bundle="$startdir/../src-tauri/target/release/bundle/deb/RampPulse_${pkgver}_amd64/data.tar.gz"
  [[ -f "$bundle" ]] || { echo "Build the Tauri deb first: $bundle" >&2; return 1; }
  tar --no-same-owner -xzf "$bundle" --directory="$pkgdir"
  sed -i 's/^Exec=airport-crm$/Exec=ramppulse/; s/^Icon=airport-crm$/Icon=ramppulse/' "$pkgdir/usr/share/applications/RampPulse.desktop"
  for icon_size in 32x32 128x128 256x256@2; do
    local icon_dir="$pkgdir/usr/share/icons/hicolor/$icon_size/apps"
    [[ -f "$icon_dir/airport-crm.png" ]] && ln -s airport-crm.png "$icon_dir/ramppulse.png"
  done
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/ramppulse/LICENSE"
}
