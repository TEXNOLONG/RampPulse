[Unit]
Description=RampPulse Rust API (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ramppulse
Group=ramppulse
WorkingDirectory=/opt/ramppulse-rust
EnvironmentFile=-/etc/ramppulse-rust.env
Environment=HOST=127.0.0.1
Environment=PORT=8001
Environment=DB_FILE=/var/lib/ramppulse-rust/dispatch.db
Environment=CHAT_STORAGE_DIR=/var/lib/ramppulse-rust/chat-attachments
Environment=AIRPORT_FILE=/opt/ramppulse-rust/data/airport_sheremetyevo.json
Environment=FRONTEND_DIR=/opt/ramppulse-rust/frontend
Environment=DEMO_MODE=0
Environment=COOKIE_SECURE=1
ExecStart=/opt/ramppulse-rust/bin/ramppulse-server
Restart=on-failure
RestartSec=3
StateDirectory=ramppulse-rust
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ramppulse-rust
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
